# ---- required ---------------------------------------------------------------
# Signs session cookies. Generate once:  openssl rand -hex 32
DGXCTL_SECRET_KEY=

# LiteLLM admin key. dgxctl uses it to register models. openssl rand -hex 24
LITELLM_MASTER_KEY=sk-
LITELLM_SALT_KEY=

POSTGRES_PASSWORD=change-me

# ---- fleet ------------------------------------------------------------------
# sim = fake fleet, no hardware needed (default, good for demos and development)
# ssh = drive real nodes
DGXCTL_DRIVER=sim

# SSH identity the control server uses to reach every node. Its PUBLIC key must
# be in ~/.ssh/authorized_keys for DGXCTL_SSH_USER on each DGX / workstation,
# and that user must be able to run docker.
FLEET_SSH_KEY=./secrets/fleet_key
DGXCTL_SSH_USER=root
# Empty accepts whatever SSH host key a node presents — fine for a demo, but it
# lets anyone who can intercept traffic on the fleet network impersonate a node
# and receive whatever the control plane sends it. To verify instead: build a
# known_hosts file with `ssh-keyscan -H <node> >> secrets/known_hosts` for
# every node, then set DGXCTL_SSH_KNOWN_HOSTS=/run/secrets/known_hosts
# (SSH_KNOWN_HOSTS_FILE picks which host file gets mounted there).
DGXCTL_SSH_KNOWN_HOSTS=
SSH_KNOWN_HOSTS_FILE=./secrets/known_hosts

# ---- vLLM -------------------------------------------------------------------
DGXCTL_VLLM_IMAGE=vllm/vllm-openai:latest
# Shared Hugging Face cache path ON THE NODES. Put it on fast local NVMe, or on
# a shared mount so a model downloaded once starts instantly everywhere after.
DGXCTL_HF_CACHE_DIR=/opt/hf-cache
DGXCTL_HF_TOKEN=

# ---- auth -------------------------------------------------------------------
# dev  = everyone is admin, no login (use only on a trusted network)
# oidc = your identity provider
DGXCTL_AUTH_MODE=dev
DGXCTL_PUBLIC_URL=http://dgxctl.your-office.lan:8080
DGXCTL_OIDC_ISSUER=
DGXCTL_OIDC_CLIENT_ID=
DGXCTL_OIDC_CLIENT_SECRET=
DGXCTL_OIDC_ADMIN_GROUPS=gpu-admins
DGXCTL_OIDC_DEPLOYER_GROUPS=gpu-deployers

# ---- mcp (agent control endpoint at /mcp) -----------------------------------
DGXCTL_MCP_ENABLED=true
# Bearer token agents must present. REQUIRED unless auth_mode=dev — without it
# the endpoint refuses to mount, because anyone who can reach /mcp can stop
# every model in the fleet.  openssl rand -hex 32
DGXCTL_MCP_TOKEN=
# The MCP transport validates the Host header as DNS-rebinding protection,
# which rejects requests once you reach the server by its real hostname.
# "*" turns that off and relies on the token. Or list hosts explicitly.
DGXCTL_MCP_ALLOWED_HOSTS=*
# What the agent behind that one shared token can do: admin (fleet + node
# management), deployer (deploy/stop/restart models, nothing structural), or
# viewer (read-only — fleet_summary, list_nodes, plan_deployment, etc., but
# every write tool refuses). Lower this for an agent you don't fully trust;
# applied fresh on every MCP call, so lowering it and restarting is enough —
# no stale admin row survives from before.
DGXCTL_MCP_ROLE=admin

# ---- network ------------------------------------------------------------
# Interface the dashboard and LiteLLM ports bind to on the host. 127.0.0.1
# means only this machine can reach them, which matters because the default
# DGXCTL_AUTH_MODE above is "dev" — every request is treated as admin, so a
# port published on the LAN (0.0.0.0) is an unauthenticated open control
# plane. Switch this to 0.0.0.0 only alongside DGXCTL_AUTH_MODE=oidc, or on a
# network you already trust every device on.
DGXCTL_BIND_ADDRESS=127.0.0.1

# ---- ports ------------------------------------------------------------------
DGXCTL_PORT=8080
LITELLM_PORT=4000
