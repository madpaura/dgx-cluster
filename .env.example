# ---- required ---------------------------------------------------------------
# Signs session cookies. Generate once:  openssl rand -hex 32
DGXCTL_SECRET_KEY=

# LiteLLM admin key. dgxctl uses it to register models. openssl rand -hex 24
LITELLM_MASTER_KEY=sk-
LITELLM_SALT_KEY=

POSTGRES_PASSWORD=change-me

# ---- fleet ------------------------------------------------------------------
# sim = fake fleet, no hardware needed (default, good for demos and development)
# ssh = drive real nodes
DGXCTL_DRIVER=sim

# SSH identity the control server uses to reach every node. Its PUBLIC key must
# be in ~/.ssh/authorized_keys for DGXCTL_SSH_USER on each DGX / workstation,
# and that user must be able to run docker.
FLEET_SSH_KEY=./secrets/fleet_key
DGXCTL_SSH_USER=root

# ---- vLLM -------------------------------------------------------------------
DGXCTL_VLLM_IMAGE=vllm/vllm-openai:latest
# Shared Hugging Face cache path ON THE NODES. Put it on fast local NVMe, or on
# a shared mount so a model downloaded once starts instantly everywhere after.
DGXCTL_HF_CACHE_DIR=/opt/hf-cache
DGXCTL_HF_TOKEN=

# ---- auth -------------------------------------------------------------------
# dev  = everyone is admin, no login (use only on a trusted network)
# oidc = your identity provider
DGXCTL_AUTH_MODE=dev
DGXCTL_PUBLIC_URL=http://dgxctl.your-office.lan:8080
DGXCTL_OIDC_ISSUER=
DGXCTL_OIDC_CLIENT_ID=
DGXCTL_OIDC_CLIENT_SECRET=
DGXCTL_OIDC_ADMIN_GROUPS=gpu-admins
DGXCTL_OIDC_DEPLOYER_GROUPS=gpu-deployers

# ---- ports ------------------------------------------------------------------
DGXCTL_PORT=8080
LITELLM_PORT=4000
